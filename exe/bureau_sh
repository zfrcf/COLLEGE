#!/usr/bin/env bash
# =====================================================================
#  Réparer le bureau — Ubuntu / GNOME — SANS sudo
#
#  Pour : écran noir, plus de barre des tâches (dock), touche Super morte,
#         impossible d'ouvrir un terminal.
#
#  Lancement (au choix) :
#    - double-clic sur « Reparer-bureau.exe » (Wine / Proton / Steam)
#    - le raccourci « Réparer le bureau » (menu, Steam, bureau)
#    - console texte (Ctrl+Alt+F3) :  bash bureau.sh
#    - une fois installé : Ctrl+Alt+R
#
#  Rien n'est supprimé : chaque réglage modifié est sauvegardé dans
#  ~/.local/share/reparer-bureau/ et restaurable depuis le menu.
# =====================================================================

set -u

URL_SCRIPT="https://raw.githubusercontent.com/zfrcf/COLLEGE/claude/stoic-knuth-div2um/bureau.sh"
TITRE="Réparer le bureau"
DATE=$(date +%Y%m%d-%H%M%S)
DOSSIER="$HOME/.local/share/reparer-bureau"
SAUVEGARDES="$DOSSIER/sauvegardes"
LOG="$DOSSIER/journal.txt"
INSTALLE="$HOME/.local/bin/reparer-bureau.sh"
LANCEUR="$HOME/.local/share/applications/reparer-bureau.desktop"
AUTOSTART="$HOME/.config/autostart/reparer-bureau.desktop"
RAPPORT=$(mktemp 2>/dev/null || echo "/tmp/reparer-bureau-$$.txt")
SELF=$(readlink -f "$0" 2>/dev/null || echo "$0")
MOI=$(id -un)

mkdir -p "$SAUVEGARDES"
trap 'rm -f "$RAPPORT"' EXIT

FORCER_TEXTE=0; HOTE=0; DEMARRAGE=0
for a in "$@"; do
  case "$a" in
    --texte) FORCER_TEXTE=1 ;;
    --hote) HOTE=1 ;;
    --au-demarrage) DEMARRAGE=1 ;;
  esac
done

journal() { echo "[$(date '+%F %T')] $*" >>"$LOG"; }
note()    { echo "$*" >>"$RAPPORT"; journal "$*"; }
a()       { command -v "$1" >/dev/null 2>&1; }

# =====================================================================
#  Environnement graphique (quand on est lancé depuis Steam, Wine, une
#  console texte, systemd… il manque souvent DISPLAY / D-Bus)
# =====================================================================
preparer_env() {
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S "$XDG_RUNTIME_DIR/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
  fi
  # En console texte (Ctrl+Alt+F3) on ne touche pas à l'affichage.
  if [ -t 0 ] && [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then return; fi
  if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    for s in "$XDG_RUNTIME_DIR"/wayland-[0-9]; do
      [ -S "$s" ] && export WAYLAND_DISPLAY="${s##*/}" && break
    done
  fi
  if [ -z "${DISPLAY:-}" ]; then
    for x in /tmp/.X11-unix/X*; do
      [ -S "$x" ] && export DISPLAY=":${x##*/X}" && break
    done
  fi
  if [ -n "${DISPLAY:-}" ] && [ -z "${XAUTHORITY:-}" ]; then
    for f in "$XDG_RUNTIME_DIR"/gdm/Xauthority "$XDG_RUNTIME_DIR"/.mutter-Xwaylandauth.* "$HOME/.Xauthority"; do
      [ -f "$f" ] && export XAUTHORITY="$f" && break
    done
  fi
}

type_session() {
  if [ -n "${XDG_SESSION_TYPE:-}" ] && [ "$XDG_SESSION_TYPE" != tty ]; then
    echo "$XDG_SESSION_TYPE"; return
  fi
  local s
  for s in $(loginctl list-sessions --no-legend 2>/dev/null | awk -v u="$MOI" '$3==u{print $1}'); do
    local t; t=$(loginctl show-session "$s" -p Type --value 2>/dev/null)
    [ "$t" = x11 ] || [ "$t" = wayland ] && { echo "$t"; return; }
  done
  echo inconnu
}

# =====================================================================
#  Interface : fenêtres (zenity) ou texte, même code derrière
# =====================================================================
MODE=texte
if { : </dev/tty; } 2>/dev/null; then TTY=/dev/tty; else TTY=/dev/stdin; fi

ui_info() {
  case "$MODE" in
    gui)  zenity --info --title="$TITRE" --width=480 --text="$1" 2>/dev/null ;;
    auto) journal "$1" ;;
    *)    echo >&2; echo -e "$1" >&2; read -rp "Entrée pour continuer…" _ <"$TTY" ;;
  esac
}

ui_oui() { # ui_oui "question" [defaut-auto: 0=oui 1=non]
  case "$MODE" in
    gui)  zenity --question --title="$TITRE" --width=480 --ok-label="Oui" --cancel-label="Non" --text="$1" 2>/dev/null ;;
    auto) return "${2:-1}" ;;
    *)    local r=""; echo >&2; read -rp "$(echo -e "$1") [o/N] " r <"$TTY"; [[ "$r" =~ ^[oOyY] ]] ;;
  esac
}

ui_texte() { # affiche un fichier
  case "$MODE" in
    gui)  zenity --text-info --title="$TITRE" --width=720 --height=560 --filename="$1" 2>/dev/null ;;
    auto) cat "$1" >>"$LOG" ;;
    *)    echo >&2; cat "$1" >&2; read -rp "Entrée pour continuer…" _ <"$TTY" ;;
  esac
}

ui_menu() { # ui_menu "texte" clé libellé clé libellé…  → affiche la clé choisie
  local texte=$1; shift
  if [ "$MODE" = gui ]; then
    zenity --list --title="$TITRE" --text="$texte" --width=640 --height=700 \
      --column=cle --column="Que veux-tu faire ?" --hide-column=1 --print-column=1 \
      --ok-label="Lancer" --cancel-label="Quitter" "$@" 2>/dev/null
    return
  fi
  local cles=() i=1
  echo >&2; echo -e "\e[1m$texte\e[0m" >&2
  while [ $# -ge 2 ]; do
    cles+=("$1"); printf '  %2d) %s\n' "$i" "$2" >&2; shift 2; i=$((i+1))
  done
  echo "   0) Quitter" >&2
  local c=""; read -rp "Ton choix : " c <"$TTY"
  if [[ "$c" =~ ^[0-9]+$ ]] && [ "$c" -ge 1 ] && [ "$c" -le ${#cles[@]} ]; then
    echo "${cles[$((c-1))]}"
  fi
}

ui_liste() { # ui_liste "texte" élément… → élément choisi
  local texte=$1; shift
  if [ "$MODE" = gui ]; then
    zenity --list --title="$TITRE" --text="$texte" --width=620 --height=420 --column="Choix" "$@" 2>/dev/null
    return
  fi
  local i=1 e
  echo >&2; echo "$texte" >&2
  for e in "$@"; do printf '  %2d) %s\n' "$i" "$e" >&2; i=$((i+1)); done
  local c=""; read -rp "Numéro : " c <"$TTY"
  [[ "$c" =~ ^[0-9]+$ ]] && [ "$c" -ge 1 ] && [ "$c" -le $# ] && echo "${!c}"
}

ui_attente() { # ui_attente "message" commande… (affiche une barre d'attente)
  local msg=$1; shift
  if [ "$MODE" = gui ]; then
    ( "$@" ) 2>>"$LOG" | zenity --progress --pulsate --auto-close --no-cancel \
        --title="$TITRE" --width=420 --text="$msg" 2>/dev/null
  else
    echo "➜ $msg" >&2; "$@" 2>>"$LOG"
  fi
}

montrer_rapport() {
  [ -s "$RAPPORT" ] && ui_texte "$RAPPORT"
  : >"$RAPPORT"
}

# =====================================================================
#  Outils GNOME
# =====================================================================
gs()  { a gsettings && gsettings "$@" 2>>"$LOG"; }

gs_liste() { # gs_liste ajouter|retirer schéma clé valeur
  local cur nouv
  cur=$(gsettings get "$2" "$3" 2>/dev/null) || return 1
  nouv=$(python3 -c '
import ast, sys
op, cur, val = sys.argv[1:4]
cur = cur.replace("@as ", "", 1)
l = ast.literal_eval(cur) if cur.strip() else []
if op == "ajouter" and val not in l: l.append(val)
if op == "retirer": l = [x for x in l if x != val]
print("[" + ", ".join(repr(x) for x in l) + "]")' "$1" "$cur" "$4" 2>/dev/null) || return 1
  gsettings set "$2" "$3" "$nouv" 2>>"$LOG"
}

shell_actif() { pgrep -u "$MOI" -x gnome-shell >/dev/null 2>&1; }

ext_systeme() { # extensions Ubuntu de base présentes sur le système
  local e
  for e in ubuntu-dock@ubuntu.com ding@rastersoft.com ubuntu-appindicators@ubuntu.com tiling-assistant@ubuntu.com; do
    [ -d "/usr/share/gnome-shell/extensions/$e" ] && echo "$e"
  done
}

ext_perso_dossier="$HOME/.local/share/gnome-shell/extensions"

# =====================================================================
#  Sauvegarde des réglages (avant toute modification)
# =====================================================================
sauvegarder_reglages() {
  local d="$SAUVEGARDES/$DATE"
  [ -d "$d" ] && return 0
  mkdir -p "$d"
  a dconf && dconf dump / >"$d/reglages.ini" 2>>"$LOG"
  [ -f "$HOME/.config/monitors.xml" ] && cp -a "$HOME/.config/monitors.xml" "$d/"
  note "• Réglages actuels sauvegardés ($DATE)"
}

# =====================================================================
#  1. Diagnostic
# =====================================================================
diagnostic() {
  local r="$RAPPORT"
  {
    echo "DIAGNOSTIC DU BUREAU — $(date '+%d/%m/%Y %H:%M')"
    echo "================================================"
    echo "Utilisateur   : $MOI"
    echo "Système       : $(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-?}")"
    echo "Session       : $(type_session)   (bureau : ${XDG_CURRENT_DESKTOP:-?})"
    echo
  } >>"$r"

  local pct; pct=$(df --output=pcent "$HOME" 2>/dev/null | tail -1 | tr -dc '0-9')
  if [ "${pct:-0}" -ge 97 ]; then
    echo "✖ DISQUE PLEIN ($pct %) — cause très probable de l'écran noir." >>"$r"
    echo "   → « Réparation rapide » propose de vider la corbeille et les caches." >>"$r"
  else
    echo "✔ Espace disque : $pct % utilisé" >>"$r"
  fi

  if shell_actif; then echo "✔ GNOME Shell (bureau, dock, touche Super) tourne" >>"$r"
  else echo "✖ GNOME Shell NE TOURNE PAS → c'est lui qui affiche le dock et le bureau." >>"$r"; fi

  if a gsettings; then
    local ok=1
    [ "$(gs get org.gnome.shell disable-user-extensions)" = true ] && \
      echo "• Extensions perso : désactivées" >>"$r"
    for e in $(ext_systeme); do
      if gs get org.gnome.shell enabled-extensions | grep -q "$e"; then :
      else echo "✖ Extension « $e » non activée (dock / icônes du bureau)" >>"$r"; ok=0; fi
      gs get org.gnome.shell disabled-extensions | grep -q "$e" && \
        { echo "✖ Extension « $e » explicitement désactivée" >>"$r"; ok=0; }
    done
    [ $ok = 1 ] && echo "✔ Dock et icônes du bureau : activés" >>"$r"
    local sup; sup=$(gs get org.gnome.mutter overlay-key)
    [ "$sup" = "'Super_L'" ] && echo "✔ Touche Super : réglée" >>"$r" \
      || echo "✖ Touche Super modifiée ($sup)" >>"$r"
  else
    echo "✖ Outils GNOME introuvables (gsettings)" >>"$r"
  fi

  if [ -d "$ext_perso_dossier" ] && [ -n "$(ls -A "$ext_perso_dossier" 2>/dev/null)" ]; then
    echo "⚠ Extensions perso installées (une extension cassée peut tout bloquer) :" >>"$r"
    ls "$ext_perso_dossier" | sed 's/^/     - /' >>"$r"
  fi

  local pasamoi
  pasamoi=$(find "$HOME" -maxdepth 2 ! -user "$MOI" 2>/dev/null | head -8)
  if [ -n "$pasamoi" ]; then
    echo "✖ Fichiers qui ne t'appartiennent pas dans ton dossier (bloquent la session) :" >>"$r"
    echo "$pasamoi" | sed 's/^/     /' >>"$r"
  else
    echo "✔ Droits du dossier personnel : OK" >>"$r"
  fi

  [ -f "$HOME/.config/monitors.xml" ] && \
    echo "• Config d'écrans personnalisée présente (peut causer un écran noir)" >>"$r"

  if dpkg --audit 2>/dev/null | grep -q .; then
    echo "✖ Mise à jour système interrompue — nécessite un compte administrateur." >>"$r"
  fi

  if lspci 2>/dev/null | grep -qi nvidia; then
    lsmod 2>/dev/null | grep -q '^nvidia' && echo "✔ Pilote NVIDIA chargé" >>"$r" \
      || echo "⚠ Carte NVIDIA sans pilote NVIDIA chargé" >>"$r"
  fi

  if a journalctl; then
    local errs
    errs=$(journalctl --user -b -p err --no-pager -q 2>/dev/null | grep -iE 'gnome-shell|mutter|extension' | tail -6)
    [ -n "$errs" ] && { echo; echo "Dernières erreurs du bureau :"; echo "$errs"; } >>"$r"
  fi
  montrer_rapport
}

# =====================================================================
#  2. Réparation rapide (garde tout)
# =====================================================================
liberer_espace() {
  local pct; pct=$(df --output=pcent "$HOME" 2>/dev/null | tail -1 | tr -dc '0-9')
  rm -rf "$HOME/.cache/thumbnails" "$HOME/.cache/gnome-shell" 2>/dev/null
  if [ "${pct:-0}" -ge 95 ]; then
    local corb="$HOME/.local/share/Trash"
    local taille; taille=$(du -sh "$corb" 2>/dev/null | cut -f1)
    if ui_oui "Ton disque est plein à $pct %.\nVider la corbeille (${taille:-0}) ?" 1; then
      rm -rf "$corb/files" "$corb/info" 2>/dev/null; note "• Corbeille vidée"
    fi
    if ui_oui "Vider aussi les caches des applications (~/.cache) ?\nSans risque : ils se reconstruisent." 0; then
      find "$HOME/.cache" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null; note "• Caches vidés"
    fi
  fi
  note "• Espace libre : $(df -h --output=avail "$HOME" | tail -1 | tr -d ' ')"
}

reparer_droits() {
  # Fichiers créés par root (souvent après un « sudo » lancé dans le dossier perso).
  # Sans sudo on ne peut pas les « reprendre », mais on peut les mettre de côté :
  # la session en recrée des propres.
  local f
  for f in .Xauthority .ICEauthority .config/dconf .config/pulse .cache .local/share/gnome-shell \
           .config/monitors.xml .config/gnome-session .local/share/keyrings; do
    local p="$HOME/$f"
    [ -e "$p" ] || continue
    if [ ! -O "$p" ]; then
      if [ "$f" = .Xauthority ] || [ "$f" = .ICEauthority ]; then
        rm -f "$p" 2>/dev/null && note "• ~/$f (appartenait à root) supprimé, sera recréé"
      elif [ "$f" = .local/share/keyrings ]; then
        note "⚠ ~/$f appartient à root : il faudra un admin (sudo chown -R $MOI ~/$f)"
      else
        mv "$p" "$p.root-$DATE" 2>/dev/null && note "• ~/$f (appartenait à root) mis de côté" \
          || note "⚠ ~/$f appartient à root et n'a pas pu être déplacé"
      fi
    fi
  done
}

activer_dock() {
  a gsettings || return
  local e
  for e in $(ext_systeme); do
    gs_liste retirer org.gnome.shell disabled-extensions "$e"
    gs_liste ajouter org.gnome.shell enabled-extensions "$e"
    shell_actif && a gnome-extensions && gnome-extensions enable "$e" 2>>"$LOG"
  done
  note "• Dock, icônes du bureau et zone de notification réactivés"
}

reparation_rapide() {
  : >"$RAPPORT"
  echo "RÉPARATION RAPIDE — tes fichiers et réglages sont conservés" >>"$RAPPORT"
  echo >>"$RAPPORT"
  sauvegarder_reglages
  liberer_espace
  reparer_droits

  if a gsettings; then
    # Extensions perso : une extension cassée suffit à faire tomber le dock
    if [ -d "$ext_perso_dossier" ] && [ -n "$(ls -A "$ext_perso_dossier" 2>/dev/null)" ]; then
      gs set org.gnome.shell disable-user-extensions true
      note "• Extensions perso mises en pause (réactivables depuis le menu)"
    fi
    gs reset org.gnome.shell disable-extension-version-validation
    activer_dock
    gs reset org.gnome.mutter overlay-key && note "• Touche Super remise en place"
    gs reset org.gnome.desktop.wm.keybindings panel-main-menu
    gs reset org.gnome.shell.keybindings toggle-overview
    gs reset org.gnome.settings-daemon.plugins.media-keys terminal && note "• Raccourci Ctrl+Alt+T (terminal) remis en place"
    # Fond d'écran introuvable = écran noir
    local fond; fond=$(gs get org.gnome.desktop.background picture-uri | tr -d "'")
    if [ -n "$fond" ] && [ "${fond#file://}" != "$fond" ] && [ ! -f "${fond#file://}" ]; then
      gs reset org.gnome.desktop.background picture-uri
      gs reset org.gnome.desktop.background picture-uri-dark
      note "• Fond d'écran introuvable → remis par défaut"
    fi
    gs reset org.gnome.desktop.session idle-delay
  fi

  if [ -f "$HOME/.config/monitors.xml" ]; then
    mv "$HOME/.config/monitors.xml" "$SAUVEGARDES/$DATE/monitors.xml.actif" 2>/dev/null
    note "• Configuration des écrans réinitialisée"
  fi

  installer_raccourcis silencieux
  echo >>"$RAPPORT"
  note "Étape suivante : « Relancer le bureau »."
  montrer_rapport
  ui_oui "Relancer le bureau maintenant ?" 0 && relancer_bureau
}

# =====================================================================
#  3. Relancer le bureau
# =====================================================================
relancer_bureau() {
  local t; t=$(type_session)
  if [ "$t" = x11 ] && a gnome-shell; then
    journal "Relance de gnome-shell (x11)"
    setsid -f gnome-shell --replace >/dev/null 2>&1 </dev/null
    sleep 4
    shell_actif && ui_info "Bureau relancé ✔\nSi le dock n'est toujours pas là : « Se déconnecter »." \
                || ui_info "Le bureau n'a pas redémarré. Choisis « Se déconnecter » ou « Redémarrer »."
  else
    ui_oui "Ta session est en mode « $t » : le bureau ne peut se relancer\nqu'en te déconnectant (tes fenêtres seront fermées).\n\nSe déconnecter maintenant ?" 1 \
      && deconnecter
  fi
}

deconnecter() {
  journal "Déconnexion"
  if shell_actif && a gnome-session-quit; then
    gnome-session-quit --logout --no-prompt 2>>"$LOG" && return
  fi
  local s
  for s in $(loginctl list-sessions --no-legend 2>/dev/null | awk -v u="$MOI" '$3==u{print $1}'); do
    [ "$(loginctl show-session "$s" -p Type --value 2>/dev/null)" != tty ] && loginctl terminate-session "$s"
  done
}

redemarrer() {
  ui_oui "Redémarrer l'ordinateur maintenant ?" 1 || return
  journal "Redémarrage"
  systemctl reboot 2>>"$LOG" || loginctl reboot 2>>"$LOG" \
    || ui_info "Le redémarrage a été refusé. Maintiens le bouton d'alimentation 5 s."
}

# =====================================================================
#  4. Extensions perso
# =====================================================================
basculer_extensions() {
  a gsettings || { ui_info "gsettings introuvable."; return; }
  if [ "$(gs get org.gnome.shell disable-user-extensions)" = true ]; then
    ui_oui "Tes extensions perso sont en pause.\nLes réactiver ?\n(Si l'écran redevient noir, reviens ici et remets-les en pause.)" 1 || return
    gs set org.gnome.shell disable-user-extensions false
    note "• Extensions perso réactivées"
  else
    gs set org.gnome.shell disable-user-extensions true
    note "• Extensions perso mises en pause"
  fi
  montrer_rapport
}

# =====================================================================
#  5. Bureau tout neuf (réglages remis à zéro, fichiers gardés)
# =====================================================================
bureau_neuf() {
  ui_oui "BUREAU TOUT NEUF\n\nRemet le bureau comme au premier jour : dock, thème, fond d'écran,\nraccourcis, extensions.\n\nTes documents, photos, jeux, téléchargements NE SONT PAS touchés.\nTes réglages actuels sont sauvegardés et restaurables.\n\nContinuer ?" 1 || return
  : >"$RAPPORT"
  sauvegarder_reglages
  local d="$SAUVEGARDES/$DATE"
  if [ -d "$ext_perso_dossier" ]; then
    mkdir -p "$d/extensions" && mv "$ext_perso_dossier"/* "$d/extensions/" 2>/dev/null
    note "• Extensions perso mises de côté"
  fi
  [ -f "$HOME/.config/monitors.xml" ] && mv "$HOME/.config/monitors.xml" "$d/monitors.xml.actif"
  rm -rf "$HOME/.cache/gnome-shell" 2>/dev/null
  reparer_droits
  if a dconf; then
    dconf reset -f / 2>>"$LOG" && note "• Tous les réglages du bureau remis à zéro"
  fi
  installer_raccourcis silencieux
  note ""
  note "Il faut maintenant te déconnecter puis te reconnecter."
  montrer_rapport
  ui_oui "Se déconnecter maintenant ?" 1 && deconnecter
}

# =====================================================================
#  6. Restaurer d'anciens réglages
# =====================================================================
restaurer() {
  local choix=() d
  for d in "$SAUVEGARDES"/*/; do
    [ -f "$d/reglages.ini" ] && choix+=("$(basename "$d")")
  done
  [ ${#choix[@]} -eq 0 ] && { ui_info "Aucune sauvegarde pour l'instant."; return; }
  local c; c=$(ui_liste "Sauvegarde à restaurer (année-mois-jour-heure) :" "${choix[@]}")
  [ -n "$c" ] || return
  d="$SAUVEGARDES/$c"
  : >"$RAPPORT"
  sauvegarder_reglages
  dconf reset -f / 2>>"$LOG"
  dconf load / <"$d/reglages.ini" 2>>"$LOG" && note "• Réglages du $c restaurés"
  if [ -d "$d/extensions" ]; then
    mkdir -p "$ext_perso_dossier" && cp -a "$d/extensions/." "$ext_perso_dossier/" && note "• Extensions restaurées"
  fi
  [ -f "$d/monitors.xml" ] && cp -a "$d/monitors.xml" "$HOME/.config/monitors.xml" && note "• Configuration d'écrans restaurée"
  note "Déconnecte-toi puis reconnecte-toi pour tout appliquer."
  montrer_rapport
}

# =====================================================================
#  7. Ouvrir un terminal
# =====================================================================
ouvrir_terminal() { # ouvrir_terminal [commande…]
  local t
  for t in gnome-terminal kgx ptyxis konsole xfce4-terminal mate-terminal tilix x-terminal-emulator xterm; do
    a "$t" || continue
    case "$t" in
      gnome-terminal|ptyxis) setsid -f "$t" -- "$@" >/dev/null 2>&1 ;;
      kgx)                   setsid -f "$t" ${1:+-e} "$@" >/dev/null 2>&1 ;;
      xfce4-terminal)        setsid -f "$t" ${1:+-x} "$@" >/dev/null 2>&1 ;;
      *)                     setsid -f "$t" ${1:+-e} "$@" >/dev/null 2>&1 ;;
    esac
    return 0
  done
  return 1
}

# =====================================================================
#  8. Raccourcis : menu des applis, bureau, Steam, Ctrl+Alt+R
# =====================================================================
ecrire_desktop() { # ecrire_desktop fichier [options]
  cat >"$1" <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Réparer le bureau
GenericName=Réparation du bureau Ubuntu
Comment=Écran noir, dock disparu, touche Super : réparer ou repartir de zéro (sans sudo)
Exec=/bin/bash "$INSTALLE" $2
Icon=preferences-desktop
Terminal=false
Categories=System;Settings;Utility;
Keywords=réparer;bureau;dock;écran noir;gnome;
StartupNotify=true
EOF
  chmod +x "$1"
}

installer_raccourcis() {
  mkdir -p "$(dirname "$INSTALLE")" "$(dirname "$LANCEUR")"
  [ "$SELF" != "$INSTALLE" ] && [ -f "$SELF" ] && cp -f "$SELF" "$INSTALLE"
  chmod +x "$INSTALLE"
  ecrire_desktop "$LANCEUR" ""
  a update-desktop-database && update-desktop-database "$(dirname "$LANCEUR")" 2>/dev/null

  local bureau
  bureau=$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Bureau")
  if [ -d "$bureau" ] && [ "$bureau" != "$HOME" ]; then
    cp -f "$LANCEUR" "$bureau/reparer-bureau.desktop"
    a gio && gio set "$bureau/reparer-bureau.desktop" metadata::trusted true 2>/dev/null
  fi

  # Raccourci clavier Ctrl+Alt+R
  if a gsettings; then
    local p=/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/reparer-bureau/
    local sch="org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:$p"
    gs_liste ajouter org.gnome.settings-daemon.plugins.media-keys custom-keybindings "$p"
    gs set "$sch" name 'Réparer le bureau'
    gs set "$sch" command "/bin/bash $INSTALLE"
    gs set "$sch" binding '<Control><Alt>r'
  fi

  if [ "${1:-}" = silencieux ]; then
    note "• Raccourcis installés : menu des applications, bureau, Ctrl+Alt+R"
  else
    ui_info "Raccourcis installés ✔\n\n• Menu des applications : « Réparer le bureau »\n• Icône sur le Bureau\n• Raccourci clavier : Ctrl + Alt + R\n• Steam : Ajouter un jeu → Ajouter un jeu non-Steam → « Réparer le bureau »"
  fi
}

basculer_autostart() {
  if [ -f "$AUTOSTART" ]; then
    rm -f "$AUTOSTART"; ui_info "L'outil ne s'ouvrira plus à chaque connexion."
  else
    mkdir -p "$(dirname "$AUTOSTART")"
    installer_raccourcis silencieux; : >"$RAPPORT"
    ecrire_desktop "$AUTOSTART" "--au-demarrage"
    echo "X-GNOME-Autostart-Delay=5" >>"$AUTOSTART"
    ui_info "L'outil s'ouvrira automatiquement à ta prochaine connexion\n(une seule fois)."
  fi
}

# =====================================================================
#  9. Sauvegarde des fichiers sur clé USB (sans sudo, via udisks)
# =====================================================================
sauvegarde_usb() {
  ui_info "Branche ta clé USB ou ton disque externe, puis clique OK."
  local parts=() l
  while IFS= read -r l; do parts+=("$l"); done < <(
    lsblk -rpno NAME,SIZE,LABEL,MOUNTPOINT,TRAN,TYPE 2>/dev/null |
    awk '$NF=="part"' | while read -r n s rest; do
      p=$(lsblk -no PKNAME "$n" 2>/dev/null | head -1)
      [ "$(cat /sys/block/"$p"/removable 2>/dev/null)" = 1 ] || \
        [ "$(lsblk -dno TRAN /dev/"$p" 2>/dev/null)" = usb ] || continue
      echo "$n  ($s $(lsblk -no LABEL "$n" | head -1))"
    done)
  [ ${#parts[@]} -eq 0 ] && { ui_info "Aucune clé USB détectée."; return; }
  local c; c=$(ui_liste "Où sauvegarder tes fichiers ?" "${parts[@]}")
  [ -n "$c" ] || return
  local dev=${c%% *}
  local mp; mp=$(lsblk -no MOUNTPOINT "$dev" | head -1)
  if [ -z "$mp" ]; then
    udisksctl mount -b "$dev" >>"$LOG" 2>&1
    mp=$(lsblk -no MOUNTPOINT "$dev" | head -1)
  fi
  [ -n "$mp" ] && [ -w "$mp" ] || { ui_info "Impossible d'écrire sur la clé."; return; }

  local excl=(--exclude=.cache --exclude='snap/*/common/.cache' --exclude=.local/share/Trash)
  if ! ui_oui "Inclure les jeux Steam ? (souvent très volumineux)" 1; then
    excl+=(--exclude=.local/share/Steam/steamapps --exclude=.steam/steam/steamapps --exclude='.var/app/com.valvesoftware.Steam')
  fi
  local cible="$mp/sauvegarde-$MOI-$DATE"
  mkdir -p "$cible"
  if a rsync; then
    ui_attente "Copie de tes fichiers en cours… (ne retire pas la clé)" rsync -rlt "${excl[@]}" "$HOME/" "$cible/"
  else
    ui_attente "Copie de tes fichiers en cours… (ne retire pas la clé)" cp -r "$HOME/." "$cible/"
  fi
  sync
  udisksctl unmount -b "$dev" >>"$LOG" 2>&1
  ui_info "Sauvegarde terminée ✔\nDossier : sauvegarde-$MOI-$DATE\nTu peux retirer la clé."
}

# =====================================================================
#  Lancement depuis Proton / Steam : le jeu tourne dans un « conteneur »
#  isolé. On relance l'outil sur le vrai système via le gestionnaire de
#  services de l'utilisateur (aucun mot de passe nécessaire).
# =====================================================================
dans_conteneur() {
  [ -d /run/pressure-vessel ] || [ -f /.flatpak-info ] || [ -e /run/host/container-manager ] \
    || ! a gsettings
}

evasion_vers_hote() {
  mkdir -p "$(dirname "$INSTALLE")"
  [ "$SELF" != "$INSTALLE" ] && cp -f "$SELF" "$INSTALLE"
  chmod +x "$INSTALLE"
  local nom="reparer-bureau-$$-$RANDOM.service"
  local D=${DISPLAY:-} W=${WAYLAND_DISPLAY:-} X=${XAUTHORITY:-}
  journal "Conteneur détecté → relance sur le système hôte"

  if a systemd-run && systemd-run --user --collect --unit="$nom" \
       --setenv=DISPLAY="$D" --setenv=WAYLAND_DISPLAY="$W" --setenv=XAUTHORITY="$X" \
       /bin/bash "$INSTALLE" --hote >>"$LOG" 2>&1; then return 0; fi

  if a busctl && busctl --user call org.freedesktop.systemd1 /org/freedesktop/systemd1 \
       org.freedesktop.systemd1.Manager StartTransientUnit 'ssa(sv)a(sa(sv))' \
       "$nom" replace 2 \
       ExecStart 'a(sasb)' 1 /bin/bash 3 /bin/bash "$INSTALLE" --hote false \
       Environment as 3 "DISPLAY=$D" "WAYLAND_DISPLAY=$W" "XAUTHORITY=$X" \
       0 >>"$LOG" 2>&1; then return 0; fi

  if a gdbus && gdbus call --session --dest org.freedesktop.systemd1 \
       --object-path /org/freedesktop/systemd1 \
       --method org.freedesktop.systemd1.Manager.StartTransientUnit "$nom" replace \
       "[('ExecStart', <[('/bin/bash', ['/bin/bash', '$INSTALLE', '--hote'], false)]>), ('Environment', <['DISPLAY=$D', 'WAYLAND_DISPLAY=$W', 'XAUTHORITY=$X']>)]" \
       "[]" >>"$LOG" 2>&1; then return 0; fi

  # Dernier recours : s'ouvrir tout seul à la prochaine connexion
  mkdir -p "$(dirname "$AUTOSTART")" "$(dirname "$LANCEUR")"
  ecrire_desktop "$AUTOSTART" "--au-demarrage"
  ecrire_desktop "$LANCEUR" ""
  cat >"$HOME/REPARER-LE-BUREAU-LISEZMOI.txt" <<EOF
L'outil « Réparer le bureau » est installé mais n'a pas pu s'ouvrir depuis Proton.

→ Déconnecte-toi puis reconnecte-toi (ou redémarre) : il s'ouvrira tout seul.
→ Ou : Ctrl+Alt+F3, connecte-toi, puis tape :   bash ~/.local/bin/reparer-bureau.sh
→ Ou : lance « Reparer-bureau.exe » avec Wine plutôt qu'avec Proton.
EOF
  return 1
}

# =====================================================================
#  Menu principal
# =====================================================================
menu_principal() {
  while true; do
    local etat="Session : $(type_session) — bureau : $(shell_actif && echo 'en marche' || echo 'ARRÊTÉ')"
    local c
    c=$(ui_menu "Réparer le bureau Ubuntu (sans mot de passe administrateur)\n$etat" \
      diag     "🔍  Diagnostic — trouver la panne" \
      rapide   "🛠  Réparation rapide — dock, Super, écran noir (garde tout)  ← commence ici" \
      relancer "🔄  Relancer le bureau" \
      ext      "🧩  Mettre en pause / réactiver mes extensions" \
      neuf     "✨  Bureau tout neuf — réglages à zéro, fichiers gardés" \
      restaure "↩  Restaurer d'anciens réglages" \
      terminal "⌨  Ouvrir un terminal" \
      usb      "💾  Sauvegarder mes fichiers sur une clé USB" \
      raccourc "📌  Installer les raccourcis (menu, bureau, Steam, Ctrl+Alt+R)" \
      auto     "⏱  Ouvrir cet outil à la prochaine connexion (oui/non)" \
      deco     "🚪  Se déconnecter" \
      reboot   "⏻  Redémarrer l'ordinateur")
    case "$c" in
      diag) diagnostic ;;
      rapide) reparation_rapide ;;
      relancer) relancer_bureau ;;
      ext) basculer_extensions ;;
      neuf) bureau_neuf ;;
      restaure) restaurer ;;
      terminal) ouvrir_terminal || ui_info "Aucun terminal installé." ;;
      usb) sauvegarde_usb ;;
      raccourc) installer_raccourcis ;;
      auto) basculer_autostart ;;
      deco) ui_oui "Se déconnecter ? Les fenêtres ouvertes seront fermées." 1 && deconnecter ;;
      reboot) redemarrer ;;
      "") exit 0 ;;
    esac
  done
}

# =====================================================================
#  Démarrage
# =====================================================================
journal "=== Lancement ($*) ==="
[ "$DEMARRAGE" = 1 ] && rm -f "$AUTOSTART"   # ouverture automatique : une seule fois

preparer_env

if [ "$HOTE" = 0 ] && dans_conteneur; then
  if evasion_vers_hote; then exit 0; fi
  exit 3
fi

if [ "$FORCER_TEXTE" = 1 ]; then
  MODE=texte
elif [ -t 0 ] && [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
  MODE=texte                                   # console Ctrl+Alt+F3
elif a zenity && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
  MODE=gui
elif [ -t 0 ]; then
  MODE=texte
elif ouvrir_terminal /bin/bash "$SELF" --texte; then
  exit 0                                       # rouvert dans un terminal
else
  # Ni fenêtre, ni terminal : réparation automatique sans risque + rapport
  MODE=auto
  reparation_rapide
  cp "$LOG" "$HOME/REPARER-LE-BUREAU-RAPPORT.txt" 2>/dev/null
  exit 0
fi

menu_principal
